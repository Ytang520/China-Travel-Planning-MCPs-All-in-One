# ===================================
# 酒店搜索MCP服务器 - 环境变量配置模板
# ===================================
# 使用方法：
# 1. 复制此文件为 .env： cp .env.example .env
# 2. 不要将 .env 文件提交到版本控制系统

# ===================================
# MCP服务器配置
# ===================================
MCP_TRANSPORT=stdio

# ===================================
# 日志配置
# ===================================
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/hotel_server.log
LOG_ERROR_FILE_PATH=logs/hotel_server_error.log
LOG_MAX_SIZE=10
LOG_BACKUP_COUNT=5

# ===================================
# 浏览器策略（携程酒店列表需要登录态；游客会被重定向到登录页）
# ===================================
# 浏览器内核选择：A=edge（默认）/ B=chrome
HOTEL_MCP_BROWSER=edge
# 显式指定浏览器可执行文件路径（优先于 HOTEL_MCP_BROWSER）
# HOTEL_MCP_BROWSER_PATH=/absolute/path/to/msedge.exe
# 无头模式（不推荐：会被携程拦截）
# HOTEL_MCP_HEADLESS=1

# ===================================
# 防封与风险控制
# ===================================
# ⚠ 风险同意开关：本功能模拟真人浏览并抓取需要登录的酒店数据，存在账号被封禁风险。
# 只有设置为 yes 时酒店搜索工具才会工作；启用即表示你已了解并自愿承担风险，作者概不负责。
HOTEL_MCP_CONSENT=no

# 两次搜索之间的随机间隔范围（秒）
HOTEL_MCP_MIN_DELAY=30
HOTEL_MCP_MAX_DELAY=300

# cookie 文件位置（可选，默认 ./ctrip-hotel-cookies.json；该文件已被 .gitignore 忽略）
# HOTEL_MCP_COOKIE_FILE=/absolute/path/to/ctrip-hotel-cookies.json
# Independent browser profile (optional)
# HOTEL_MCP_PROFILE_DIR=./.browser-profile
# Wait for manual login: 1–840 seconds; default 840
# HOTEL_MCP_LOGIN_TIMEOUT=840

# Discovery: registered install -> named shutil.which -> common locations -> one DrissionPage attempt.
# macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux example: /usr/bin/google-chrome
# Windows Python: .venv/Scripts/python.exe; macOS/Linux: .venv/bin/python (Python 3.11+).
