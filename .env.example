AMAP_MAPS_API_KEY=your_amap_maps_api_key
DIDI_MCP_KEY=your_didi_mcp_key

# Optional overrides
TRAIN_12306_ENTRY=./12306-mcp/build/index.js
FLIGHT_MCP_PROJECT_ROOT=./FlightTicketMCP
# Auto-detect a usable root .venv, then FlightTicketMCP/.venv (Python 3.11+).
# FLIGHT_MCP_PYTHON_COMMAND=/absolute/path/to/python
# 浏览器内核选择：A=edge（默认）/ B=chrome；携程反爬需要可见浏览器
FLIGHT_MCP_BROWSER=edge
# 显式浏览器可执行文件路径（优先于 FLIGHT_MCP_BROWSER）
# FLIGHT_MCP_BROWSER_PATH=/absolute/path/to/msedge.exe
# 无头模式（不推荐：会被携程 whaleguard 拦截）
# FLIGHT_MCP_HEADLESS=1

# ===== 酒店域（hotel/ctrip）=====
HOTEL_MCP_PROJECT_ROOT=./HotelTicketMCP
# Auto-detect a usable root .venv, then HotelTicketMCP/.venv (Python 3.11+).
# HOTEL_MCP_PYTHON_COMMAND=/absolute/path/to/python
# 浏览器内核选择：A=edge（默认）/ B=chrome（与航班一致）
HOTEL_MCP_BROWSER=edge
# 显式浏览器可执行文件路径（优先于 HOTEL_MCP_BROWSER）
# HOTEL_MCP_BROWSER_PATH=/absolute/path/to/msedge.exe
# 无头模式（不推荐：会被携程拦截）
# HOTEL_MCP_HEADLESS=1
# ⚠ 酒店搜索风险同意开关：本功能模拟真人浏览并抓取需要登录的酒店数据，存在账号被封禁风险。
# 只有设置为 yes 时酒店工具才会工作；启用即表示自愿承担风险，作者概不负责。
# HOTEL_MCP_CONSENT=yes
# 两次酒店搜索之间的随机间隔范围（秒，默认 15~180）
# HOTEL_MCP_MIN_DELAY=15
# HOTEL_MCP_MAX_DELAY=180
# 酒店登录 cookie 文件位置（可选，默认 HotelTicketMCP/ctrip-hotel-cookies.json，已被 .gitignore 忽略）
# HOTEL_MCP_COOKIE_FILE=/absolute/path/to/ctrip-hotel-cookies.json
# Independent browser profile (optional; useful for isolated login tests)
# HOTEL_MCP_PROFILE_DIR=/absolute/path/to/hotel-profile
# Wait for manual login: 1–840 seconds; default 840
# HOTEL_MCP_LOGIN_TIMEOUT=840

# Discovery: registered install -> named shutil.which -> common locations -> one DrissionPage attempt.
# macOS example: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux example: /usr/bin/google-chrome
# Windows Python: .venv/Scripts/python.exe; macOS/Linux: .venv/bin/python (Python 3.11+).
